//@version=5
indicator("XAUT Signal Suite - Buy/Sell/Reentry + SR + TP/SL", overlay=true, max_lines_count=200, max_labels_count=200)

// ============ INPUTS ============
grp1 = "Moving Average Crossover"
fastLen   = input.int(9,  "Fast MA length", group=grp1)
slowLen   = input.int(21, "Slow MA length", group=grp1)
maType    = input.string("EMA", "MA type", options=["SMA","EMA"], group=grp1)

grp2 = "ATR Stop Loss / Take Profit"
atrLen    = input.int(14, "ATR length", group=grp2)
slMult    = input.float(1.5, "Stop loss ATR multiplier", step=0.1, group=grp2)
tpMult    = input.float(3.0, "Take profit ATR multiplier", step=0.1, group=grp2)

grp3 = "Support / Resistance"
pivotLR   = input.int(10, "Pivot left/right bars", group=grp3)
srTol     = input.float(0.3, "Touch tolerance (%)", step=0.05, group=grp3) / 100
minTouch  = input.int(3, "Min touches = Strong level", group=grp3)
maxLevels = input.int(6, "Max levels tracked each side", group=grp3)

grp4 = "Alerts"
showLabels = input.bool(true, "Show TP/SL labels", group=grp4)

// ============ MOVING AVERAGES ============
fastMA = maType == "EMA" ? ta.ema(close, fastLen) : ta.sma(close, fastLen)
slowMA = maType == "EMA" ? ta.ema(close, slowLen) : ta.sma(close, slowLen)

plot(fastMA, "Fast MA", color=color.gray, linewidth=1)
plot(slowMA, "Slow MA", color=color.orange, linewidth=1)

crossUp   = ta.crossover(fastMA, slowMA)
crossDown = ta.crossunder(fastMA, slowMA)

// ============ SIGNAL STATE (first vs reentry) ============
var string lastSignal = na   // "buy" or "sell"

isBuy     = crossUp  and (lastSignal != "buy")
isReBuy   = crossUp  and (lastSignal == "buy")
isSell    = crossDown and (lastSignal != "sell")
isReSell  = crossDown and (lastSignal == "sell")

if crossUp
    lastSignal := "buy"
if crossDown
    lastSignal := "sell"

// ============ ATR TP / SL ============
atrVal = ta.atr(atrLen)

// plot SL/TP whenever a fresh or reentry signal fires, using persistent lines
var line slLine = na
var line tpLine = na
var label slLabel = na
var label tpLabel = na

if isBuy or isReBuy
    slPrice = close - atrVal * slMult
    tpPrice = close + atrVal * tpMult
    line.delete(slLine)
    line.delete(tpLine)
    label.delete(slLabel)
    label.delete(tpLabel)
    slLine := line.new(bar_index, slPrice, bar_index + 20, slPrice, color=color.red, width=1, style=line.style_dashed)
    tpLine := line.new(bar_index, tpPrice, bar_index + 20, tpPrice, color=color.green, width=1, style=line.style_dashed)
    if showLabels
        slLabel := label.new(bar_index, slPrice, "SL " + str.tostring(slPrice, format.mintick), style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
        tpLabel := label.new(bar_index, tpPrice, "TP " + str.tostring(tpPrice, format.mintick), style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)

if isSell or isReSell
    slPriceS = close + atrVal * slMult
    tpPriceS = close - atrVal * tpMult
    line.delete(slLine)
    line.delete(tpLine)
    label.delete(slLabel)
    label.delete(tpLabel)
    slLine := line.new(bar_index, slPriceS, bar_index + 20, slPriceS, color=color.red, width=1, style=line.style_dashed)
    tpLine := line.new(bar_index, tpPriceS, bar_index + 20, tpPriceS, color=color.green, width=1, style=line.style_dashed)
    if showLabels
        slLabel := label.new(bar_index, slPriceS, "SL " + str.tostring(slPriceS, format.mintick), style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
        tpLabel := label.new(bar_index, tpPriceS, "TP " + str.tostring(tpPriceS, format.mintick), style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

// ============ SIGNAL SHAPES ============
plotshape(isBuy,    "Buy",         style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0),  size=size.small, text="BUY")
plotshape(isReBuy,   "Reentry Buy", style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 30),  size=size.tiny,  text="RE-B")
plotshape(isSell,    "Sell",        style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),    size=size.small, text="SELL")
plotshape(isReSell,  "Reentry Sell",style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 30),size=size.tiny,  text="RE-S")

// ============ SUPPORT / RESISTANCE (pivot-based, strong vs weak) ============
ph = ta.pivothigh(high, pivotLR, pivotLR)
pl = ta.pivotlow(low, pivotLR, pivotLR)

var float[] resLevels = array.new_float(0)
var int[]   resTouch  = array.new_int(0)
var float[] supLevels = array.new_float(0)
var int[]   supTouch  = array.new_int(0)

// helper: update or insert a level with touch counting
updateLevel(arr, touchArr, price) =>
    matched = false
    for i = 0 to array.size(arr) - 1
        lvl = array.get(arr, i)
        if math.abs(price - lvl) / lvl <= srTol
            newTouch = array.get(touchArr, i) + 1
            array.set(touchArr, i, newTouch)
            array.set(arr, i, (lvl + price) / 2)
            matched := true
    if not matched
        array.push(arr, price)
        array.push(touchArr, 1)
        if array.size(arr) > maxLevels
            array.shift(arr)
            array.shift(touchArr)

if not na(ph)
    updateLevel(resLevels, resTouch, ph)
if not na(pl)
    updateLevel(supLevels, supTouch, pl)

// draw current levels each bar (only on last bar to avoid clutter)
if barstate.islast
    for i = 0 to array.size(resLevels) - 1
        lvl = array.get(resLevels, i)
        touches = array.get(resTouch, i)
        strong = touches >= minTouch
        line.new(bar_index - 100, lvl, bar_index + 20, lvl,
             color = strong ? color.new(color.red, 0) : color.new(color.red, 70),
             width = strong ? 2 : 1,
             style = strong ? line.style_solid : line.style_dotted,
             extend = extend.none)
        label.new(bar_index + 20, lvl, (strong ? "Resistance kuat (" : "Resistance lemah (") + str.tostring(touches) + "x)",
             style=label.style_label_left, color=color.new(color.red, strong ? 0 : 70), textcolor=color.white, size=size.tiny)

    for i = 0 to array.size(supLevels) - 1
        lvl = array.get(supLevels, i)
        touches = array.get(supTouch, i)
        strong = touches >= minTouch
        line.new(bar_index - 100, lvl, bar_index + 20, lvl,
             color = strong ? color.new(color.green, 0) : color.new(color.green, 70),
             width = strong ? 2 : 1,
             style = strong ? line.style_solid : line.style_dotted,
             extend = extend.none)
        label.new(bar_index + 20, lvl, (strong ? "Support kuat (" : "Support lemah (") + str.tostring(touches) + "x)",
             style=label.style_label_left, color=color.new(color.green, strong ? 0 : 70), textcolor=color.white, size=size.tiny)

// ============ ALERTS ============
alertcondition(isBuy,   "XAUT Buy Signal",         "XAUT: Fresh BUY signal (MA crossover)")
alertcondition(isReBuy, "XAUT Reentry Buy Signal", "XAUT: REENTRY BUY signal (trend continuation)")
alertcondition(isSell,  "XAUT Sell Signal",         "XAUT: Fresh SELL signal (MA crossover)")
alertcondition(isReSell,"XAUT Reentry Sell Signal", "XAUT: REENTRY SELL signal (trend continuation)")
